<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <IsTestProject>true</IsTestProject>
    <!-- Never publish the test executable into the release artifacts.
         release.yml publishes the whole solution; without this the tarball/zip
         shipped to users carries a ~107 MB self-contained test runner. -->
    <IsPublishable>false</IsPublishable>
    <!-- xUnit v3 test projects are self-hosting executables running on Microsoft.Testing.Platform
         (see global.json: `dotnet test` uses the MTP runner, not VSTest). -->
    <OutputType>Exe</OutputType>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="xunit.v3" Version="4.0.3" />
    <!-- Transitive deps via xunit.v3; pinned explicitly so they resolve to the
         latest patch instead of the xunit.v3 4.0.3 floor (2.5.2). The four
         Microsoft.Testing.* packages move as one set — mixing 2.5.2 and 2.5.3
         leaves the runner and its extensions on different versions. -->
    <PackageReference Include="Microsoft.Testing.Platform" Version="2.5.3" />
    <PackageReference Include="Microsoft.Testing.Platform.MSBuild" Version="2.5.3" />
    <PackageReference Include="Microsoft.Testing.Extensions.Telemetry" Version="2.5.3" />
    <PackageReference Include="Microsoft.Testing.Extensions.TrxReport.Abstractions" Version="2.5.3" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="../NeuralDeck.csproj" />
  </ItemGroup>
</Project>
