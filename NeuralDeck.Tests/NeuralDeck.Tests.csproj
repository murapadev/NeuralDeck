<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <IsTestProject>true</IsTestProject>
    <!-- Never publish the test executable into the release artifacts.
         release.yml publishes the whole solution; without this the tarball/zip
         shipped to users carries a ~107 MB self-contained test runner. -->
    <IsPublishable>false</IsPublishable>
    <!-- xUnit v3 test projects are self-hosting executables running on Microsoft.Testing.Platform
         (see global.json: `dotnet test` uses the MTP runner, not VSTest). -->
    <OutputType>Exe</OutputType>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="xunit.v3" Version="4.0.3" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="../NeuralDeck.csproj" />
  </ItemGroup>
</Project>
