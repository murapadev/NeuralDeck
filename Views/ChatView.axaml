<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="NeuralDeck.Views.ChatView">

    <Grid RowDefinitions="Auto,*,Auto">
        <!-- Header -->
        <Border Grid.Row="0"
                Background="#18181b"
                BorderBrush="#27272a"
                BorderThickness="0,0,0,1"
                Padding="16,12">
            <Grid ColumnDefinitions="*,Auto">
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <Ellipse Width="8" Height="8"
                             Fill="#22c55e"
                             VerticalAlignment="Center"/>
                    <TextBlock Text="Connected"
                               FontSize="12"
                               Foreground="#71717a"
                               VerticalAlignment="Center"/>
                </StackPanel>

                <Button Grid.Column="1"
                        Padding="8">
                    <Path Data="M3,6H5V5A1,1 0 0,1 6,4H8A1,1 0 0,1 9,5V6H17A1,1 0 0,0 18,5V3H6V5H3V19H17V17H5V19H3V6M7,9V11H13V9H7M7,13V15H11V13H7Z"
                          Fill="#71717a"
                          Width="16" Height="16"
                          Stretch="Uniform"/>
                </Button>
            </Grid>
        </Border>

        <!-- Messages Area -->
        <ScrollViewer Grid.Row="1" Padding="16,8">
            <StackPanel>
                <TextBlock Text="Welcome to NeuralDeck Chat!"
                           FontSize="14"
                           Foreground="#71717a"
                           HorizontalAlignment="Center"
                           Margin="0,100,0,0"/>
            </StackPanel>
        </ScrollViewer>

        <!-- Input Area -->
        <Border Grid.Row="2"
                Background="#18181b"
                BorderBrush="#27272a"
                BorderThickness="0,1,0,0"
                Padding="16,12">
            <Grid ColumnDefinitions="*,Auto">
                <TextBox Grid.Column="0"
                         Watermark="Type a message..."
                         MinHeight="44"
                         Background="#27272a"
                         Foreground="#fafafa"
                         BorderThickness="0"
                         Padding="12,8"
                         FontSize="14"/>

                <Button Grid.Column="1"
                        Margin="8,0,0,0"
                        Width="44" Height="44"
                        Padding="0">
                    <Path Data="M2,21L23,12L2,3V10L17,12L2,14V21Z"
                          Fill="#6366f1"
                          Width="20" Height="20"
                          Stretch="Uniform"/>
                </Button>
            </Grid>
        </Border>
    </Grid>
</UserControl>
