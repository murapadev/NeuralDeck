<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:NeuralDeck.ViewModels"
             xmlns:models="clr-namespace:NeuralDeck.Models"
             xmlns:controls="clr-namespace:NeuralDeck.Controls"
             x:Class="NeuralDeck.Views.ChatView"
             x:DataType="vm:ChatViewModel">

    <Grid RowDefinitions="Auto,*,Auto">

        <!-- Header: connection status + model selector -->
        <Border Grid.Row="0" Background="#18181b"
                BorderBrush="#27272a" BorderThickness="0,0,0,1"
                Padding="12,10">
            <Grid ColumnDefinitions="Auto,*,Auto">
                <!-- Connection status -->
                <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="6"
                            VerticalAlignment="Center">
                    <Ellipse Width="8" Height="8"
                             Fill="{Binding IsConnected, Converter={StaticResource BoolToColorConverter}}"
                             VerticalAlignment="Center"/>
                    <TextBlock Text="{Binding ConnectionStatus}"
                               FontSize="12" Foreground="#71717a"
                               VerticalAlignment="Center"/>
                </StackPanel>

                <!-- Model selector -->
                <ComboBox Grid.Column="1"
                          ItemsSource="{Binding Models}"
                          SelectedItem="{Binding SelectedModel}"
                          IsVisible="{Binding IsConnected}"
                          HorizontalAlignment="Center"
                          MaxWidth="160"
                          Background="#27272a"
                          Foreground="#fafafa"
                          BorderBrush="#3f3f46"
                          FontSize="12">
                    <ComboBox.ItemTemplate>
                        <DataTemplate x:DataType="models:OllamaModel">
                            <TextBlock Text="{Binding DisplayName}" FontSize="12" ToolTip.Tip="{Binding Name}"/>
                        </DataTemplate>
                    </ComboBox.ItemTemplate>
                </ComboBox>

                <!-- Export + Clear buttons -->
                <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="2"
                            IsVisible="{Binding HasMessages}">
                    <Button Padding="8,4"
                            Click="OnExportClick"
                            ToolTip.Tip="Export conversation">
                        <Path Width="16" Height="16" Stretch="Uniform" Fill="#71717a"
                              Data="M5,20H19V18H5M19,9H15V3H9V9H5L12,16L19,9Z"/>
                    </Button>
                    <Button Padding="8,4"
                            Command="{Binding ClearConversationCommand}"
                            ToolTip.Tip="Clear conversation">
                        <Path Width="16" Height="16" Stretch="Uniform" Fill="#71717a"
                              Data="M9,3V4H4V6H5V19A2,2 0 0,0 7,21H17A2,2 0 0,0 19,19V6H20V4H15V3H9M7,6H17V19H7V6M9,8V17H11V8H9M13,8V17H15V8H13Z"/>
                    </Button>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Messages area -->
        <ScrollViewer Grid.Row="1" x:Name="MessagesScrollViewer"
                      Padding="0" Background="#09090b">
            <Panel>
                <!-- Empty state -->
                <StackPanel IsVisible="{Binding !IsConnected}"
                            VerticalAlignment="Center" HorizontalAlignment="Center"
                            Spacing="12" Margin="24">
                    <Path Width="48" Height="48" Stretch="Uniform" Fill="#3f3f46"
                          HorizontalAlignment="Center"
                          Data="M12,2A10,10 0 0,0 2,12A10,10 0 0,0 12,22A10,10 0 0,0 22,12A10,10 0 0,0 12,2M12,4A8,8 0 0,1 20,12A8,8 0 0,1 12,20A8,8 0 0,1 4,12A8,8 0 0,1 12,4M13,7H11V9H13V7M13,11H11V17H13V11Z"/>
                    <TextBlock Text="Ollama not connected" FontSize="14" FontWeight="Medium"
                               Foreground="#a1a1aa" HorizontalAlignment="Center"/>
                    <TextBlock Text="{Binding OllamaBaseUrl, StringFormat='Trying {0}'}"
                               FontSize="11" Foreground="#52525b"
                               HorizontalAlignment="Center" TextWrapping="Wrap"
                               TextAlignment="Center"/>
                    <Button Content="Retry" Command="{Binding CheckConnectionCommand}"
                            Padding="20,8" Background="#27272a" Foreground="#a1a1aa"
                            CornerRadius="8" HorizontalAlignment="Center"
                            IsEnabled="{Binding !IsLoadingModels}"/>
                </StackPanel>

                <StackPanel IsVisible="{Binding IsConnected}">
                    <!-- Welcome message when no messages -->
                    <TextBlock IsVisible="{Binding !HasMessages}"
                               Text="Start a conversation with Ollama"
                               FontSize="13" Foreground="#71717a"
                               HorizontalAlignment="Center"
                               Margin="0,80,0,0"/>

                    <!-- Message list -->
                    <ItemsControl ItemsSource="{Binding Messages}"
                                  Margin="10,8">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="models:ChatMessage">
                                <Grid Margin="0,6">
                                    <!-- Assistant message (left, neutral tile) -->
                                    <Grid IsVisible="{Binding !IsUser}"
                                          HorizontalAlignment="Left" MaxWidth="520">
                                        <Border CornerRadius="10,10,10,2"
                                                Padding="14,10"
                                                Background="#27272a">
                                            <Panel>
                                                <!-- While Ollama is streaming: fast plain text (no markdown parse per token) -->
                                                <SelectableTextBlock Text="{Binding Content}"
                                                                     IsVisible="{Binding IsStreaming}"
                                                                     TextWrapping="Wrap"
                                                                     Foreground="#e4e4e7"
                                                                     FontSize="13"
                                                                     LineHeight="19"/>
                                                <!-- After streaming completes: full markdown rendering -->
                                                <controls:MarkdownTextBlock Text="{Binding Content}"
                                                                            IsVisible="{Binding !IsStreaming}"
                                                                            BaseSize="13"/>
                                            </Panel>
                                        </Border>
                                        <!-- Copy button — top-right overlay, visible only when not streaming -->
                                        <Button IsVisible="{Binding !IsStreaming}"
                                                HorizontalAlignment="Right" VerticalAlignment="Top"
                                                Margin="0,4,4,0"
                                                Width="22" Height="22" Padding="0" CornerRadius="4"
                                                Opacity="0.45"
                                                Tag="{Binding Content}"
                                                Click="OnCopyClick"
                                                ToolTip.Tip="Copy message">
                                            <Path Width="11" Height="11" Stretch="Uniform" Fill="#a1a1aa"
                                                  Data="M19,21H8V7H19M19,5H8A2,2 0 0,0 6,7V21A2,2 0 0,0 8,23H19A2,2 0 0,0 21,21V7A2,2 0 0,0 19,5M16,1H4A2,2 0 0,0 2,3V17H4V3H16V1Z"/>
                                        </Button>
                                    </Grid>
                                    <!-- User message (right, accent-tinted) -->
                                    <Border IsVisible="{Binding IsUser}"
                                            CornerRadius="10,10,2,10"
                                            Padding="14,10"
                                            Background="#1e1b4b"
                                            BorderBrush="{DynamicResource AccentBrush}"
                                            BorderThickness="0,0,0,0"
                                            HorizontalAlignment="Right"
                                            MaxWidth="520">
                                        <TextBlock Text="{Binding Content}"
                                                   TextWrapping="Wrap"
                                                   Foreground="#e0e7ff"
                                                   FontSize="13"
                                                   LineHeight="20"/>
                                    </Border>
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <!-- Loading indicator (animated pulsing dots) -->
                    <Border IsVisible="{Binding IsLoading}"
                            HorizontalAlignment="Left"
                            Margin="8,4"
                            CornerRadius="8,8,8,2"
                            Padding="12,12"
                            Background="#27272a">
                        <StackPanel Orientation="Horizontal" Spacing="5">
                            <Ellipse Width="7" Height="7" Fill="{DynamicResource AccentBrush}">
                                <Ellipse.Styles>
                                    <Style Selector="Ellipse">
                                        <Style.Animations>
                                            <Animation Duration="0:0:1.2" IterationCount="Infinite">
                                                <KeyFrame Cue="0%"><Setter Property="Opacity" Value="1"/></KeyFrame>
                                                <KeyFrame Cue="33%"><Setter Property="Opacity" Value="0.2"/></KeyFrame>
                                                <KeyFrame Cue="66%"><Setter Property="Opacity" Value="1"/></KeyFrame>
                                                <KeyFrame Cue="100%"><Setter Property="Opacity" Value="1"/></KeyFrame>
                                            </Animation>
                                        </Style.Animations>
                                    </Style>
                                </Ellipse.Styles>
                            </Ellipse>
                            <Ellipse Width="7" Height="7" Fill="{DynamicResource AccentBrush}">
                                <Ellipse.Styles>
                                    <Style Selector="Ellipse">
                                        <Style.Animations>
                                            <Animation Duration="0:0:1.2" Delay="0:0:0.4" IterationCount="Infinite">
                                                <KeyFrame Cue="0%"><Setter Property="Opacity" Value="1"/></KeyFrame>
                                                <KeyFrame Cue="33%"><Setter Property="Opacity" Value="0.2"/></KeyFrame>
                                                <KeyFrame Cue="66%"><Setter Property="Opacity" Value="1"/></KeyFrame>
                                                <KeyFrame Cue="100%"><Setter Property="Opacity" Value="1"/></KeyFrame>
                                            </Animation>
                                        </Style.Animations>
                                    </Style>
                                </Ellipse.Styles>
                            </Ellipse>
                            <Ellipse Width="7" Height="7" Fill="{DynamicResource AccentBrush}">
                                <Ellipse.Styles>
                                    <Style Selector="Ellipse">
                                        <Style.Animations>
                                            <Animation Duration="0:0:1.2" Delay="0:0:0.8" IterationCount="Infinite">
                                                <KeyFrame Cue="0%"><Setter Property="Opacity" Value="1"/></KeyFrame>
                                                <KeyFrame Cue="33%"><Setter Property="Opacity" Value="0.2"/></KeyFrame>
                                                <KeyFrame Cue="66%"><Setter Property="Opacity" Value="1"/></KeyFrame>
                                                <KeyFrame Cue="100%"><Setter Property="Opacity" Value="1"/></KeyFrame>
                                            </Animation>
                                        </Style.Animations>
                                    </Style>
                                </Ellipse.Styles>
                            </Ellipse>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </Panel>
        </ScrollViewer>

        <!-- Input area -->
        <Border Grid.Row="2" Background="#18181b"
                BorderBrush="#27272a" BorderThickness="0,1,0,0"
                Padding="12,10">
            <Grid ColumnDefinitions="*,Auto">
                <TextBox Grid.Column="0"
                         x:Name="MessageInput"
                         Text="{Binding InputText}"
                         Watermark="Message Ollama..."
                         MinHeight="40" MaxHeight="120"
                         AcceptsReturn="True"
                         TextWrapping="Wrap"
                         Background="#27272a"
                         Foreground="#fafafa"
                         BorderThickness="1"
                         BorderBrush="#3f3f46"
                         CornerRadius="8"
                         Padding="12,10"
                         FontSize="13"
                         IsEnabled="{Binding IsConnected}"/>
                <!-- Send (idle) -->
                <Button Grid.Column="1"
                        Command="{Binding SendMessageCommand}"
                        IsEnabled="{Binding IsConnected}"
                        IsVisible="{Binding !IsLoading}"
                        Margin="8,0,0,0"
                        Width="40" Height="40"
                        CornerRadius="8"
                        Padding="0"
                        ToolTip.Tip="Send (Enter)">
                    <Path Width="18" Height="18" Stretch="Uniform" Fill="#6366f1"
                          Data="M2,21L23,12L2,3V10L17,12L2,14V21Z"/>
                </Button>
                <!-- Stop (while streaming) -->
                <Button Grid.Column="1"
                        Command="{Binding CancelStreamCommand}"
                        IsVisible="{Binding IsLoading}"
                        Margin="8,0,0,0"
                        Width="40" Height="40"
                        CornerRadius="8"
                        Padding="0"
                        Background="#ef4444"
                        ToolTip.Tip="Stop generating">
                    <Rectangle Width="14" Height="14" Fill="#fafafa" RadiusX="2" RadiusY="2"/>
                </Button>
            </Grid>
        </Border>
    </Grid>
</UserControl>
