<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:NeuralDeck.ViewModels"
             xmlns:models="clr-namespace:NeuralDeck.Models"
             x:Class="NeuralDeck.Views.ChatView"
             x:DataType="vm:ChatViewModel">

    <Grid RowDefinitions="Auto,*,Auto">

        <!-- Header: connection status + model selector -->
        <Border Grid.Row="0" Background="#18181b"
                BorderBrush="#27272a" BorderThickness="0,0,0,1"
                Padding="12,10">
            <Grid ColumnDefinitions="Auto,*,Auto">
                <!-- Connection status -->
                <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="6"
                            VerticalAlignment="Center">
                    <Ellipse Width="8" Height="8"
                             Fill="{Binding IsConnected, Converter={StaticResource BoolToColorConverter}}"
                             VerticalAlignment="Center"/>
                    <TextBlock Text="{Binding ConnectionStatus}"
                               FontSize="12" Foreground="#71717a"
                               VerticalAlignment="Center"/>
                </StackPanel>

                <!-- Model selector -->
                <ComboBox Grid.Column="1"
                          ItemsSource="{Binding Models}"
                          SelectedItem="{Binding SelectedModel}"
                          IsVisible="{Binding IsConnected}"
                          HorizontalAlignment="Center"
                          MaxWidth="160"
                          Background="#27272a"
                          Foreground="#fafafa"
                          BorderBrush="#3f3f46"
                          FontSize="12">
                    <ComboBox.ItemTemplate>
                        <DataTemplate x:DataType="models:OllamaModel">
                            <TextBlock Text="{Binding Name}" FontSize="12"/>
                        </DataTemplate>
                    </ComboBox.ItemTemplate>
                </ComboBox>

                <!-- Clear button -->
                <Button Grid.Column="2" Padding="8,4"
                        Command="{Binding ClearConversationCommand}"
                        ToolTip.Tip="Clear conversation"
                        IsVisible="{Binding IsConnected}">
                    <Path Width="16" Height="16" Stretch="Uniform" Fill="#71717a"
                          Data="M9,3V4H4V6H5V19A2,2 0 0,0 7,21H17A2,2 0 0,0 19,19V6H20V4H15V3H9M7,6H17V19H7V6M9,8V17H11V8H9M13,8V17H15V8H13Z"/>
                </Button>
            </Grid>
        </Border>

        <!-- Messages area -->
        <ScrollViewer Grid.Row="1" x:Name="MessagesScrollViewer"
                      Padding="0" Background="#09090b">
            <Panel>
                <!-- Empty state -->
                <StackPanel IsVisible="{Binding !IsConnected}"
                            VerticalAlignment="Center" HorizontalAlignment="Center"
                            Spacing="12" Margin="24">
                    <Path Width="48" Height="48" Stretch="Uniform" Fill="#3f3f46"
                          HorizontalAlignment="Center"
                          Data="M12,2A10,10 0 0,0 2,12A10,10 0 0,0 12,22A10,10 0 0,0 22,12A10,10 0 0,0 12,2M12,4A8,8 0 0,1 20,12A8,8 0 0,1 12,20A8,8 0 0,1 4,12A8,8 0 0,1 12,4M11,16.5L6.5,12L7.91,10.59L11,13.67L16.59,8.09L18,9.5L11,16.5Z"/>
                    <TextBlock Text="Ollama not connected" FontSize="14"
                               Foreground="#71717a" HorizontalAlignment="Center"/>
                    <TextBlock Text="Make sure Ollama is running on localhost:11434"
                               FontSize="12" Foreground="#52525b"
                               HorizontalAlignment="Center" TextWrapping="Wrap"
                               TextAlignment="Center"/>
                </StackPanel>

                <StackPanel IsVisible="{Binding IsConnected}">
                    <!-- Welcome message when no messages -->
                    <TextBlock IsVisible="{Binding !HasMessages}"
                               Text="Start a conversation with Ollama"
                               FontSize="13" Foreground="#71717a"
                               HorizontalAlignment="Center"
                               Margin="0,80,0,0"/>

                    <!-- Message list -->
                    <ItemsControl ItemsSource="{Binding Messages}"
                                  Margin="8,8">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="models:ChatMessage">
                                <Grid ColumnDefinitions="*,*" Margin="0,4">
                                    <!-- Assistant message (left) -->
                                    <Border Grid.Column="0"
                                            IsVisible="{Binding !IsUser}"
                                            CornerRadius="8,8,8,2"
                                            Padding="12,8"
                                            Background="#27272a"
                                            HorizontalAlignment="Left"
                                            MaxWidth="280">
                                        <TextBlock Text="{Binding Content}"
                                                   TextWrapping="Wrap"
                                                   Foreground="#d4d4d8"
                                                   FontSize="13"
                                                   LineHeight="20"/>
                                    </Border>
                                    <!-- User message (right) -->
                                    <Border Grid.Column="1"
                                            IsVisible="{Binding IsUser}"
                                            CornerRadius="8,8,2,8"
                                            Padding="12,8"
                                            Background="#1e1b4b"
                                            HorizontalAlignment="Right"
                                            MaxWidth="280">
                                        <TextBlock Text="{Binding Content}"
                                                   TextWrapping="Wrap"
                                                   Foreground="#e0e7ff"
                                                   FontSize="13"
                                                   LineHeight="20"/>
                                    </Border>
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <!-- Loading indicator -->
                    <Border IsVisible="{Binding IsLoading}"
                            HorizontalAlignment="Left"
                            Margin="8,4"
                            CornerRadius="8,8,8,2"
                            Padding="12,10"
                            Background="#27272a">
                        <StackPanel Orientation="Horizontal" Spacing="4">
                            <Ellipse Width="6" Height="6" Fill="#6366f1"/>
                            <Ellipse Width="6" Height="6" Fill="#6366f1" Opacity="0.6"/>
                            <Ellipse Width="6" Height="6" Fill="#6366f1" Opacity="0.3"/>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </Panel>
        </ScrollViewer>

        <!-- Input area -->
        <Border Grid.Row="2" Background="#18181b"
                BorderBrush="#27272a" BorderThickness="0,1,0,0"
                Padding="12,10">
            <Grid ColumnDefinitions="*,Auto">
                <TextBox Grid.Column="0"
                         x:Name="MessageInput"
                         Text="{Binding InputText}"
                         Watermark="Message Ollama..."
                         MinHeight="40" MaxHeight="120"
                         AcceptsReturn="True"
                         TextWrapping="Wrap"
                         Background="#27272a"
                         Foreground="#fafafa"
                         BorderThickness="1"
                         BorderBrush="#3f3f46"
                         CornerRadius="8"
                         Padding="12,10"
                         FontSize="13"
                         IsEnabled="{Binding IsConnected}"/>
                <Button Grid.Column="1"
                        Command="{Binding SendMessageCommand}"
                        IsEnabled="{Binding IsConnected}"
                        Margin="8,0,0,0"
                        Width="40" Height="40"
                        CornerRadius="8"
                        Padding="0">
                    <Path Width="18" Height="18" Stretch="Uniform" Fill="#6366f1"
                          Data="M2,21L23,12L2,3V10L17,12L2,14V21Z"/>
                </Button>
            </Grid>
        </Border>
    </Grid>
</UserControl>
