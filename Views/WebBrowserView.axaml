<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:NeuralDeck.ViewModels"
             xmlns:controls="clr-namespace:Avalonia.Controls;assembly=Avalonia.Controls.WebView"
             x:Class="NeuralDeck.Views.WebBrowserView"
             x:DataType="vm:WebBrowserViewModel">

    <Grid RowDefinitions="Auto,*,Auto">

        <!-- Toolbar -->
        <Border Grid.Row="0"
                Background="#18181b"
                BorderBrush="#27272a"
                BorderThickness="0,0,0,1"
                Padding="6,4">
            <Grid ColumnDefinitions="Auto,Auto,Auto,*,Auto,Auto">

                <Button Grid.Column="0" Width="28" Height="28" Padding="0" CornerRadius="6"
                        Command="{Binding GoBackCommand}"
                        ToolTip.Tip="Back">
                    <Path Width="12" Height="12" Stretch="Uniform" Fill="#a1a1aa"
                          Data="M20,11V13H8L13.5,18.5L12.08,19.92L4.16,12L12.08,4.08L13.5,5.5L8,11H20Z"/>
                </Button>

                <Button Grid.Column="1" Width="28" Height="28" Padding="0" CornerRadius="6"
                        Margin="2,0,0,0"
                        Command="{Binding GoForwardCommand}"
                        ToolTip.Tip="Forward">
                    <Path Width="12" Height="12" Stretch="Uniform" Fill="#a1a1aa"
                          Data="M4,11V13H16L10.5,18.5L11.92,19.92L19.84,12L11.92,4.08L10.5,5.5L16,11H4Z"/>
                </Button>

                <Button Grid.Column="2" Width="28" Height="28" Padding="0" CornerRadius="6"
                        Margin="2,0,6,0"
                        Command="{Binding ReloadCommand}"
                        ToolTip.Tip="Reload (Ctrl+R / F5)">
                    <Path Width="12" Height="12" Stretch="Uniform" Fill="#a1a1aa"
                          Data="M17.65,6.35C16.2,4.9 14.21,4 12,4A8,8 0 0,0 4,12A8,8 0 0,0 12,20C15.73,20 18.84,17.45 19.73,14H17.65C16.83,16.33 14.61,18 12,18A6,6 0 0,1 6,12A6,6 0 0,1 12,6C13.66,6 15.14,6.69 16.22,7.78L13,11H20V4L17.65,6.35Z"/>
                </Button>

                <TextBox x:Name="AddressBar"
                         Grid.Column="3"
                         Text="{Binding AddressBarText}"
                         Background="#27272a"
                         Foreground="#fafafa"
                         BorderBrush="#3f3f46"
                         CornerRadius="6"
                         Padding="8,0"
                         Height="28"
                         FontSize="11"
                         VerticalContentAlignment="Center"
                         PlaceholderText="Enter URL..."
                         ToolTip.Tip="{Binding PageTitle}"/>

                <Button Grid.Column="4" Width="28" Height="28" Padding="0" CornerRadius="6"
                        Margin="4,0,0,0"
                        Command="{Binding GoCommand}"
                        ToolTip.Tip="Navigate (Enter)">
                    <Path Width="10" Height="10" Stretch="Uniform" Fill="#a1a1aa"
                          Data="M4,11V13H16L10.5,18.5L11.92,19.92L19.84,12L11.92,4.08L10.5,5.5L16,11H4Z"/>
                </Button>

                <Button Grid.Column="5" Width="28" Height="28" Padding="0" CornerRadius="6"
                        Margin="2,0,0,0"
                        Command="{Binding OpenInBrowserCommand}"
                        ToolTip.Tip="Open in external browser">
                    <Path Width="12" Height="12" Stretch="Uniform" Fill="#a1a1aa"
                          Data="M14,3V5H17.59L7.76,14.83L9.17,16.24L19,6.41V10H21V3M19,19H5V5H12V3H5C3.89,3 3,3.9 3,5V19A2,2 0 0,0 5,21H19A2,2 0 0,0 21,19V12H19V19Z"/>
                </Button>
            </Grid>
        </Border>

        <!-- Loading progress bar -->
        <ProgressBar Grid.Row="0"
                     Height="2"
                     VerticalAlignment="Bottom"
                     Margin="0,0,0,-1"
                     IsIndeterminate="True"
                     IsVisible="{Binding IsLoading}"
                     Background="Transparent"
                     Foreground="#6366f1"/>

        <!-- Embedded web view -->
        <Grid Grid.Row="1" Background="#0a0a0b">
            <controls:NativeWebView x:Name="Browser"/>

            <!-- Fallback if native webview fails to initialize -->
            <StackPanel IsVisible="{Binding ShowFallback}"
                        VerticalAlignment="Center" HorizontalAlignment="Center"
                        Spacing="16" Margin="24">
                <Border Width="56" Height="56" CornerRadius="14"
                        Background="#1a1a1d" BorderBrush="#27272a" BorderThickness="1"
                        HorizontalAlignment="Center">
                    <TextBlock Text="🌐" FontSize="24"
                               HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Border>
                <TextBlock Text="{Binding FallbackMessage}"
                           FontSize="12" Foreground="#71717a"
                           HorizontalAlignment="Center" TextWrapping="Wrap"
                           MaxWidth="320" TextAlignment="Center"/>
                <Button Content="Open in Browser"
                        Command="{Binding OpenInBrowserCommand}"
                        Padding="20,10" Background="#6366f1" Foreground="#fafafa"
                        CornerRadius="8" HorizontalAlignment="Center"/>
            </StackPanel>
        </Grid>

        <!-- Status bar: shows page title / host after load, or loading message -->
        <Border Grid.Row="2"
                Background="#18181b"
                BorderBrush="#27272a"
                BorderThickness="0,1,0,0"
                Padding="10,3"
                IsVisible="{Binding StatusText, Converter={x:Static StringConverters.IsNotNullOrEmpty}}">
            <TextBlock Text="{Binding StatusText}"
                       FontSize="10"
                       Foreground="#52525b"
                       TextTrimming="CharacterEllipsis"/>
        </Border>
    </Grid>
</UserControl>
