<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:NeuralDeck.ViewModels"
             xmlns:models="clr-namespace:NeuralDeck.Models"
             x:Class="NeuralDeck.Views.SettingsView"
             x:DataType="vm:SettingsViewModel"
             Background="#09090b">

    <Grid RowDefinitions="Auto,*,Auto">

        <!-- Tab bar -->
        <ScrollViewer Grid.Row="0"
                      HorizontalScrollBarVisibility="Auto"
                      VerticalScrollBarVisibility="Disabled"
                      Background="#18181b"
                      Padding="8,6">
            <StackPanel Orientation="Horizontal" Spacing="2">
                <Button Content="General" Padding="12,6" FontSize="12" CornerRadius="6"
                        Command="{Binding SelectTabCommand}" CommandParameter="general"
                        Foreground="{Binding SelectedTab, Converter={StaticResource TabForegroundConverter}, ConverterParameter=general}"
                        Background="{Binding SelectedTab, Converter={StaticResource TabBackgroundConverter}, ConverterParameter=general}"/>
                <Button Content="Appearance" Padding="12,6" FontSize="12" CornerRadius="6"
                        Command="{Binding SelectTabCommand}" CommandParameter="appearance"
                        Foreground="{Binding SelectedTab, Converter={StaticResource TabForegroundConverter}, ConverterParameter=appearance}"
                        Background="{Binding SelectedTab, Converter={StaticResource TabBackgroundConverter}, ConverterParameter=appearance}"/>
                <Button Content="Shortcuts" Padding="12,6" FontSize="12" CornerRadius="6"
                        Command="{Binding SelectTabCommand}" CommandParameter="shortcuts"
                        Foreground="{Binding SelectedTab, Converter={StaticResource TabForegroundConverter}, ConverterParameter=shortcuts}"
                        Background="{Binding SelectedTab, Converter={StaticResource TabBackgroundConverter}, ConverterParameter=shortcuts}"/>
                <Button Content="Privacy" Padding="12,6" FontSize="12" CornerRadius="6"
                        Command="{Binding SelectTabCommand}" CommandParameter="privacy"
                        Foreground="{Binding SelectedTab, Converter={StaticResource TabForegroundConverter}, ConverterParameter=privacy}"
                        Background="{Binding SelectedTab, Converter={StaticResource TabBackgroundConverter}, ConverterParameter=privacy}"/>
                <Button Content="Window" Padding="12,6" FontSize="12" CornerRadius="6"
                        Command="{Binding SelectTabCommand}" CommandParameter="window"
                        Foreground="{Binding SelectedTab, Converter={StaticResource TabForegroundConverter}, ConverterParameter=window}"
                        Background="{Binding SelectedTab, Converter={StaticResource TabBackgroundConverter}, ConverterParameter=window}"/>
                <Button Content="Providers" Padding="12,6" FontSize="12" CornerRadius="6"
                        Command="{Binding SelectTabCommand}" CommandParameter="providers"
                        Foreground="{Binding SelectedTab, Converter={StaticResource TabForegroundConverter}, ConverterParameter=providers}"
                        Background="{Binding SelectedTab, Converter={StaticResource TabBackgroundConverter}, ConverterParameter=providers}"/>
                <Button Content="About" Padding="12,6" FontSize="12" CornerRadius="6"
                        Command="{Binding SelectTabCommand}" CommandParameter="about"
                        Foreground="{Binding SelectedTab, Converter={StaticResource TabForegroundConverter}, ConverterParameter=about}"
                        Background="{Binding SelectedTab, Converter={StaticResource TabBackgroundConverter}, ConverterParameter=about}"/>
            </StackPanel>
        </ScrollViewer>

        <!-- Tab content -->
        <Grid Grid.Row="1">

            <!-- General -->
            <ScrollViewer IsVisible="{Binding SelectedTab, Converter={StaticResource EqualityConverter}, ConverterParameter=general}">
                <StackPanel Spacing="16" Margin="16">
                    <TextBlock Text="General" FontSize="16" FontWeight="SemiBold" Foreground="#fafafa"/>

                    <StackPanel Spacing="4">
                        <TextBlock Text="Ollama server URL" FontSize="12" Foreground="#71717a"/>
                        <TextBox Text="{Binding OllamaUrl}" Width="320" HorizontalAlignment="Left"
                                 Watermark="http://localhost:11434"/>
                        <TextBlock Text="Where the local Ollama daemon listens. Leave default unless you've changed Ollama's bind address."
                                   FontSize="11" Foreground="#52525b" TextWrapping="Wrap" MaxWidth="420"/>
                    </StackPanel>

                    <CheckBox Content="Debug mode" IsChecked="{Binding DebugMode}" Foreground="#d4d4d8"/>

                    <Button Content="Save" Command="{Binding SaveGeneralCommand}"
                            Padding="16,8" Background="{DynamicResource AccentBrush}" Foreground="#fafafa"
                            CornerRadius="6" HorizontalAlignment="Left"/>
                </StackPanel>
            </ScrollViewer>

            <!-- Appearance -->
            <ScrollViewer IsVisible="{Binding SelectedTab, Converter={StaticResource EqualityConverter}, ConverterParameter=appearance}">
                <StackPanel Spacing="16" Margin="16">
                    <TextBlock Text="Appearance" FontSize="16" FontWeight="SemiBold" Foreground="#fafafa"/>

                    <StackPanel Spacing="6">
                        <TextBlock Text="Theme" FontSize="12" Foreground="#71717a"/>
                        <ComboBox ItemsSource="{Binding ThemeOptions}"
                                  SelectedItem="{Binding Theme}"
                                  Width="200" HorizontalAlignment="Left"/>
                    </StackPanel>

                    <StackPanel Spacing="6">
                        <TextBlock Text="Language" FontSize="12" Foreground="#71717a"/>
                        <ComboBox ItemsSource="{Binding LanguageOptions}"
                                  SelectedItem="{Binding Language}"
                                  Width="200" HorizontalAlignment="Left"/>
                    </StackPanel>

                    <StackPanel Spacing="6">
                        <TextBlock Text="Font size" FontSize="12" Foreground="#71717a"/>
                        <ComboBox ItemsSource="{Binding FontSizeOptions}"
                                  SelectedItem="{Binding FontSize}"
                                  Width="200" HorizontalAlignment="Left"/>
                    </StackPanel>

                    <StackPanel Spacing="6">
                        <TextBlock Text="Accent color" FontSize="12" Foreground="#71717a"/>
                        <ListBox ItemsSource="{Binding ColorOptions}"
                                 SelectedItem="{Binding AccentColor}"
                                 Background="Transparent"
                                 BorderThickness="0"
                                 Padding="0">
                            <ListBox.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <StackPanel Orientation="Horizontal" Spacing="4"/>
                                </ItemsPanelTemplate>
                            </ListBox.ItemsPanel>
                            <ListBox.ItemTemplate>
                                <DataTemplate x:DataType="x:String">
                                    <Border Width="28" Height="28" CornerRadius="14"
                                            Background="{Binding ., Converter={StaticResource StringToColorConverter}}"
                                            ToolTip.Tip="{Binding .}"/>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                            <ListBox.Styles>
                                <Style Selector="ListBoxItem">
                                    <Setter Property="Padding" Value="2"/>
                                    <Setter Property="CornerRadius" Value="16"/>
                                    <Setter Property="Background" Value="Transparent"/>
                                </Style>
                                <Style Selector="ListBoxItem:selected /template/ ContentPresenter">
                                    <Setter Property="Background" Value="Transparent"/>
                                    <Setter Property="BorderBrush" Value="#fafafa"/>
                                    <Setter Property="BorderThickness" Value="2"/>
                                    <Setter Property="CornerRadius" Value="16"/>
                                </Style>
                            </ListBox.Styles>
                        </ListBox>
                    </StackPanel>

                    <CheckBox Content="Show provider names" IsChecked="{Binding ShowProviderNames}" Foreground="#d4d4d8"/>

                    <Button Content="Save" Command="{Binding SaveAppearanceCommand}"
                            Padding="16,8" Background="{DynamicResource AccentBrush}" Foreground="#fafafa"
                            CornerRadius="6" HorizontalAlignment="Left"/>
                </StackPanel>
            </ScrollViewer>

            <!-- Shortcuts -->
            <ScrollViewer IsVisible="{Binding SelectedTab, Converter={StaticResource EqualityConverter}, ConverterParameter=shortcuts}">
                <StackPanel Spacing="14" Margin="16">
                    <TextBlock Text="Keyboard Shortcuts" FontSize="16" FontWeight="SemiBold" Foreground="#fafafa"/>
                    <TextBlock Text="Modifiers: CommandOrControl, Shift, Alt, Meta. Separate with +."
                               FontSize="11" Foreground="#71717a" TextWrapping="Wrap"/>

                    <StackPanel Spacing="4">
                        <TextBlock Text="Toggle window" FontSize="12" Foreground="#71717a"/>
                        <TextBox Text="{Binding ToggleWindowShortcut}" Width="280" HorizontalAlignment="Left"/>
                    </StackPanel>

                    <StackPanel Spacing="4">
                        <TextBlock Text="Open settings" FontSize="12" Foreground="#71717a"/>
                        <TextBox Text="{Binding OpenSettingsShortcut}" Width="280" HorizontalAlignment="Left"/>
                    </StackPanel>

                    <Border Background="#18181b" CornerRadius="6" Padding="12,8">
                        <StackPanel Spacing="4">
                            <TextBlock Text="Built-in shortcuts (read-only):" FontSize="11" Foreground="#a1a1aa"/>
                            <TextBlock FontSize="11" Foreground="#71717a">
                                <Run Text="• Ctrl+Shift+1..5 — switch to provider N"/><LineBreak/>
                                <Run Text="• Ctrl+Q — quit NeuralDeck"/><LineBreak/>
                                <Run Text="• Esc (in Settings) — close Settings window"/>
                            </TextBlock>
                        </StackPanel>
                    </Border>

                    <Button Content="Save" Command="{Binding SaveShortcutsCommand}"
                            Padding="16,8" Background="{DynamicResource AccentBrush}" Foreground="#fafafa"
                            CornerRadius="6" HorizontalAlignment="Left"/>
                </StackPanel>
            </ScrollViewer>

            <!-- Privacy -->
            <ScrollViewer IsVisible="{Binding SelectedTab, Converter={StaticResource EqualityConverter}, ConverterParameter=privacy}">
                <StackPanel Spacing="16" Margin="16">
                    <TextBlock Text="Privacy" FontSize="16" FontWeight="SemiBold" Foreground="#fafafa"/>

                    <StackPanel Spacing="4">
                        <CheckBox Content="Clear Ollama history on close" IsChecked="{Binding ClearOnClose}" Foreground="#d4d4d8"/>
                        <TextBlock Text="Deletes the local Ollama conversation history file (~/.config/NeuralDeck/ollama-history.json) when the app exits. Web provider sessions (cookies, cache) are managed by the OS WebView and are not affected."
                                   FontSize="11" Foreground="#52525b" TextWrapping="Wrap" MaxWidth="460" Margin="24,0,0,0"/>
                    </StackPanel>

                    <StackPanel Spacing="4">
                        <CheckBox Content="Block trackers (web providers)" IsChecked="{Binding BlockTrackers}" Foreground="#d4d4d8"/>
                        <TextBlock Text="Enables the system WebView's built-in content filtering when available. Effect depends on OS and WebKit version."
                                   FontSize="11" Foreground="#52525b" TextWrapping="Wrap" MaxWidth="460" Margin="24,0,0,0"/>
                    </StackPanel>

                    <Button Content="Save" Command="{Binding SavePrivacyCommand}"
                            Padding="16,8" Background="{DynamicResource AccentBrush}" Foreground="#fafafa"
                            CornerRadius="6" HorizontalAlignment="Left"/>
                </StackPanel>
            </ScrollViewer>

            <!-- Window -->
            <ScrollViewer IsVisible="{Binding SelectedTab, Converter={StaticResource EqualityConverter}, ConverterParameter=window}">
                <StackPanel Spacing="16" Margin="16">
                    <TextBlock Text="Window" FontSize="16" FontWeight="SemiBold" Foreground="#fafafa"/>
                    <CheckBox Content="Always on top" IsChecked="{Binding AlwaysOnTop}" Foreground="#d4d4d8"/>
                    <CheckBox Content="Hide on blur" IsChecked="{Binding HideOnBlur}" Foreground="#d4d4d8"/>

                    <StackPanel Spacing="6">
                        <TextBlock Text="Position" FontSize="12" Foreground="#71717a"/>
                        <ComboBox ItemsSource="{Binding PositionOptions}"
                                  SelectedItem="{Binding WindowPosition}"
                                  Width="200" HorizontalAlignment="Left"/>
                    </StackPanel>

                    <StackPanel Spacing="6">
                        <TextBlock Text="{Binding WindowOpacity, StringFormat='Opacity: {0:P0}'}"
                                   FontSize="12" Foreground="#71717a"/>
                        <Slider Value="{Binding WindowOpacity}"
                                Minimum="0.1" Maximum="1.0"
                                Width="260" HorizontalAlignment="Left"/>
                    </StackPanel>

                    <Button Content="Save" Command="{Binding SaveWindowCommand}"
                            Padding="16,8" Background="{DynamicResource AccentBrush}" Foreground="#fafafa"
                            CornerRadius="6" HorizontalAlignment="Left"/>
                </StackPanel>
            </ScrollViewer>

            <!-- Providers -->
            <ScrollViewer IsVisible="{Binding SelectedTab, Converter={StaticResource EqualityConverter}, ConverterParameter=providers}">
                <StackPanel Spacing="16" Margin="16">
                    <TextBlock Text="Providers" FontSize="16" FontWeight="SemiBold" Foreground="#fafafa"/>
                    <TextBlock Text="Enable or disable AI providers. Custom providers open in the embedded browser."
                               FontSize="12" Foreground="#71717a" TextWrapping="Wrap"/>

                    <ItemsControl ItemsSource="{Binding Providers}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="models:ProviderConfig">
                                <Border Background="#18181b" CornerRadius="8"
                                        Padding="12,10" Margin="0,0,0,6">
                                    <Grid ColumnDefinitions="Auto,*,Auto,Auto">
                                        <Border Grid.Column="0" Width="32" Height="32"
                                                CornerRadius="8" Margin="0,0,10,0"
                                                Background="#27272a">
                                            <Grid>
                                                <Viewbox Width="18" Height="18" Stretch="Uniform">
                                                    <Path Data="{Binding Id, Converter={StaticResource ProviderIconConverter}}"
                                                          Fill="{Binding Color, Converter={StaticResource StringToColorConverter}}"/>
                                                </Viewbox>
                                                <Image Source="{Binding Id, Converter={StaticResource ProviderFaviconConverter}}"
                                                       Width="24" Height="24" Stretch="Uniform"
                                                       RenderOptions.BitmapInterpolationMode="HighQuality"/>
                                            </Grid>
                                        </Border>
                                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                            <TextBlock Text="{Binding Name}" FontSize="13"
                                                       FontWeight="Medium" Foreground="#fafafa"/>
                                            <TextBlock Text="{Binding Url}" FontSize="11"
                                                       Foreground="#52525b" TextTrimming="CharacterEllipsis"/>
                                        </StackPanel>
                                        <CheckBox Grid.Column="2" IsChecked="{Binding Enabled}"
                                                  VerticalAlignment="Center" Margin="0,0,6,0"/>
                                        <!-- Delete button – only for custom providers -->
                                        <Button Grid.Column="3"
                                                Width="28" Height="28" Padding="0" CornerRadius="6"
                                                IsVisible="{Binding IsCustom}"
                                                VerticalAlignment="Center"
                                                ToolTip.Tip="Remove provider"
                                                Command="{Binding $parent[ItemsControl].((vm:SettingsViewModel)DataContext).RemoveProviderCommand}"
                                                CommandParameter="{Binding}">
                                            <Path Width="10" Height="10" Stretch="Uniform" Fill="#ef4444"
                                                  Data="M19,6.41L17.59,5L12,10.59L6.41,5L5,6.41L10.59,12L5,17.59L6.41,19L12,13.41L17.59,19L19,17.59L13.41,12L19,6.41Z"/>
                                        </Button>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <!-- Add provider form -->
                    <Border IsVisible="{Binding IsAddingProvider}"
                            Background="#18181b" CornerRadius="8" Padding="12">
                        <StackPanel Spacing="8">
                            <TextBlock Text="New provider" FontSize="13" FontWeight="Medium" Foreground="#fafafa"/>
                            <TextBox Text="{Binding NewProviderName}"
                                     Watermark="Name (e.g. Mistral)"
                                     Height="32" FontSize="12"/>
                            <TextBox Text="{Binding NewProviderUrl}"
                                     Watermark="URL (e.g. https://chat.mistral.ai)"
                                     Height="32" FontSize="12"/>
                            <StackPanel Spacing="6">
                                <TextBlock Text="Color" FontSize="11" Foreground="#71717a"/>
                                <ComboBox ItemsSource="{Binding ColorOptions}"
                                          SelectedItem="{Binding NewProviderColor}"
                                          Width="160" HorizontalAlignment="Left"/>
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <Button Content="Add" Command="{Binding ConfirmAddProviderCommand}"
                                        Padding="16,6" Background="{DynamicResource AccentBrush}" Foreground="#fafafa" CornerRadius="6"/>
                                <Button Content="Cancel" Command="{Binding CancelAddProviderCommand}"
                                        Padding="16,6" Background="#27272a" Foreground="#a1a1aa" CornerRadius="6"/>
                            </StackPanel>
                        </StackPanel>
                    </Border>

                    <!-- Action buttons -->
                    <StackPanel Orientation="Horizontal" Spacing="8"
                                IsVisible="{Binding !IsAddingProvider}">
                        <Button Content="Add custom provider" Command="{Binding ShowAddProviderFormCommand}"
                                Padding="16,8" Background="#27272a" Foreground="#a1a1aa"
                                CornerRadius="6"/>
                        <Button Content="Save" Command="{Binding SaveProvidersCommand}"
                                Padding="16,8" Background="{DynamicResource AccentBrush}" Foreground="#fafafa"
                                CornerRadius="6"/>
                    </StackPanel>
                </StackPanel>
            </ScrollViewer>

            <!-- About -->
            <ScrollViewer IsVisible="{Binding SelectedTab, Converter={StaticResource EqualityConverter}, ConverterParameter=about}">
                <StackPanel Spacing="20" Margin="16" HorizontalAlignment="Center">
                    <Image Width="72" Height="72"
                           HorizontalAlignment="Center" Margin="0,24,0,0"
                           Source="avares://NeuralDeck/Assets/Icons/app.png"/>
                    <TextBlock Text="NeuralDeck" FontSize="22" FontWeight="Bold"
                               Foreground="#fafafa" HorizontalAlignment="Center"/>
                    <TextBlock Text="{Binding AppVersion, StringFormat='Version {0}'}"
                               FontSize="13" Foreground="#71717a" HorizontalAlignment="Center"/>
                    <TextBlock Text="Your AI command center"
                               FontSize="13" Foreground="#52525b" HorizontalAlignment="Center"/>
                    <Button Content="View on GitHub" Command="{Binding OpenGitHubCommand}"
                            Padding="20,10" Background="#27272a" Foreground="#fafafa"
                            CornerRadius="8" HorizontalAlignment="Center"/>
                </StackPanel>
            </ScrollViewer>
        </Grid>

        <!-- Bottom active-tab indicator -->
        <Border Grid.Row="2" Background="#18181b"
                BorderBrush="#27272a" BorderThickness="0,1,0,0"
                Padding="16,8">
            <TextBlock FontSize="11" Foreground="#52525b">
                <Run Text="Config: "/>
                <Run Text="{Binding AppVersion, Mode=OneWay, StringFormat='v{0}'}"/>
            </TextBlock>
        </Border>
    </Grid>
</UserControl>
