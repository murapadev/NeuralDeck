<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:converters="clr-namespace:NeuralDeck.Converters"
             x:Class="NeuralDeck.App"
             RequestedThemeVariant="Dark">

    <Application.Styles>
        <FluentTheme />
    </Application.Styles>

    <Application.Resources>
        <!-- Accent color is reassigned at runtime by ThemeService from config.Appearance.AccentColor -->
        <Color x:Key="AccentColor">#6366f1</Color>
        <SolidColorBrush x:Key="AccentBrush" Color="#6366f1"/>

        <converters:BoolToVisibilityConverter x:Key="BoolToVisibilityConverter"/>
        <converters:BoolToAccentConverter x:Key="BoolToAccentConverter"/>
        <converters:BoolToColorConverter x:Key="BoolToColorConverter"/>
        <converters:StringToColorConverter x:Key="StringToColorConverter"/>
        <converters:EqualityConverter x:Key="EqualityConverter"/>
        <converters:FirstTwoConverter x:Key="FirstTwoConverter"/>
        <converters:RoleToBrushConverter x:Key="RoleToBrushConverter"/>
        <converters:StepToDotConverter x:Key="StepToDotConverter"/>
        <converters:ProviderIconConverter x:Key="ProviderIconConverter"/>
        <converters:ProviderFaviconConverter x:Key="ProviderFaviconConverter"/>
        <converters:BoolToOpacityConverter x:Key="BoolToOpacityConverter"/>
        <converters:TabForegroundConverter x:Key="TabForegroundConverter"/>
        <converters:TabBackgroundConverter x:Key="TabBackgroundConverter"/>
    </Application.Resources>
</Application>
